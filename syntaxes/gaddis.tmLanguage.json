{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Gaddis Español",
	"scopeName": "source.gaddis-es",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#storage"
		},
		{
			"include": "#support"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.endblock.gaddis",
					"match": "\\bFin\\s+(Si|Mientras|Hacer|Para|Funcion|Procedimiento|Seleccionar)\\b"
				},
				{
					"name": "keyword.control.conditional.gaddis",
					"match": "\\b(Si|Entonces|Sino|Sino\\s+Si|Seleccionar|Caso|Defecto)\\b"
				},
				{
					"name": "keyword.control.loop.gaddis",
					"match": "\\b(Mientras|Hacer|Para|Hasta|Paso)\\b"
				},
				{
					"name": "keyword.control.module.gaddis",
					"match": "\\b(Funcion|Procedimiento|Llamar|Retornar)\\b"
				},
				{
					"name": "keyword.declaration.gaddis",
					"match": "\\b(Declarar|Constante|Como)\\b"
				},
				{
					"name": "keyword.operator.word.gaddis",
					"match": "\\b(Y|O|NO|MOD)\\b"
				},
				{
					"name": "keyword.operator.assignment.gaddis",
					"match": "(<-|←)"
				},
				{
					"name": "keyword.operator.arithmetic.gaddis",
					"match": "(\\+|-|\\*|/|\\^|MOD)"
				},
				{
					"name": "keyword.operator.relational.gaddis",
					"match": "(<>|<=|>=|=|<|>)"
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"name": "variable.other.gaddis",
					"match": "(?<=\\bDeclarar\\s)[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"name": "variable.other.assignment.gaddis",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(<-|←))"
				},
				{
					"name": "constant.other.gaddis",
					"match": "(?<=\\bConstante\\s)[A-Z_][A-Z0-9_]*"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"match": "\\bFuncion\\s+(?:Entero|Real|Cadena|Caracter|Booleano)?\\s*([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "entity.name.function.definition.gaddis"
						}
					}
				},
				{
					"match": "\\bProcedimiento\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "entity.name.procedure.definition.gaddis"
						}
					}
				},
				{
					"match": "\\bProcedimiento\\s+(Principal)\\b",
					"captures": {
						"1": {
							"name": "entity.name.main.gaddis"
						}
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.gaddis",
					"begin": "\"",
					"end": "\""
				}
			]
		},
		"storage": {
			"patterns": [
				{
					"name": "storage.type.gaddis",
					"match": "\\b(Entero|Real|Cadena|Caracter|Booleano)\\b"
				}
			]
		},
		"support": {
			"patterns": [
				{
					"name": "support.function.gaddis",
					"match": "\\b(Leer|Escribir|Abrir|LeerArchivo|EscribirArchivo|Cerrar|Renombrar|Eliminar)\\b"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.gaddis",
					"match": "(//).*$"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.gaddis",
					"match": "\\b(Verdadero|Falso|Nulo)\\b"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.gaddis",
					"match": "(\\(|\\)|\\[|\\]|\\{|\\}|,|:|;|\\.)"
				}
			]
		}
	}
}