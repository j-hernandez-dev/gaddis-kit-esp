{
    "name": "Gaddis Español",
    "scopeName": "source.gaddis-es",

    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#characters"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#booleans"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        }
    ],

    "repository": {

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.gaddis",
                    "match": "//.*$"
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.gaddis",
                    "begin": "\"",
                    "end": "\""
                }
            ]
        },

        "characters": {
            "patterns": [
                {
                    "name": "string.quoted.single.gaddis",
                    "match": "'([^'\\\\]|\\\\.)'"
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.gaddis",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.gaddis",
                    "match": "\\b\\d+\\b"
                }
            ]
        },

        "keywords": {
            "patterns": [

                {
                    "name": "keyword.control.conditional.gaddis",
                    "match": "\\b(Si|Entonces|Sino|Seleccionar|Caso|Defecto)\\b"
                },

                {
                    "name": "keyword.control.loop.gaddis",
                    "match": "\\b(Mientras|Para|Hasta|Paso)\\b"
                },

                {
                    "name": "keyword.control.module.gaddis",
                    "match": "\\b(Funcion|Procedimiento|Llamar|Retornar)\\b"
                },

                {
                    "name": "keyword.control.end.gaddis",
                    "match": "\\bFin\\s+(Si|Mientras|Para|Funcion|Procedimiento|Seleccionar)\\b"
                },

                {
                    "name": "keyword.declaration.gaddis",
                    "match": "\\b(Declarar|Constante)\\b"
                }
            ]
        },

        "types": {
            "patterns": [
                {
                    "name": "storage.type.gaddis",
                    "match": "\\b(Entero|Real|Cadena|Caracter|Logico)\\b"
                }
            ]
        },

        "booleans": {
            "patterns": [
                {
                    "name": "constant.language.boolean.gaddis",
                    "match": "\\b(Verdad|Falso)\\b"
                }
            ]
        },

        "operators": {
            "patterns": [

                {
                    "name": "keyword.operator.assignment.gaddis",
                    "match": "<-"
                },

                {
                    "name": "keyword.operator.logical.gaddis",
                    "match": "\\b(Y|O|NO)\\b"
                },

                {
                    "name": "keyword.operator.comparison.gaddis",
                    "match": "(<=|>=|!=|=|<|>)"
                },

                {
                    "name": "keyword.operator.arithmetic.gaddis",
                    "match": "(\\+|-|\\*|/|\\^|%)"
                }
            ]
        },

        "functions": {
            "patterns": [

                {
                    "name": "entity.name.function.gaddis",
                    "match": "(?<=\\bFuncion\\s(?:Entero|Real|Cadena|Caracter|Logico)\\s)[A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*"
                },

                {
                    "name": "entity.name.procedure.gaddis",
                    "match": "(?<=\\bProcedimiento\\s)[A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*"
                }
            ]
        },

        "calls": {
            "patterns": [

                {
                    "name": "support.function.call.gaddis",
                    "match": "\\b[A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*(?=\\()"
                },

                {
                    "name": "support.function.procedure-call.gaddis",
                    "match": "(?<=\\bLlamar\\s)[A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*"
                }
            ]
        },

        "constants": {
            "patterns": [
                {
                    "name": "constant.other.gaddis",
                    "match": "(?<=\\bConstante\\s(?:Entero|Real|Cadena|Caracter|Logico)\\s)[A-Za-z_][A-Za-z0-9_]*"
                }
            ]
        },

        "variables": {
            "patterns": [

                {
                    "name": "variable.other.assignment.gaddis",
                    "match": "\\b[A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*(?=\\s*<-)"
                },

                {
                    "name": "variable.other.array.gaddis",
                    "match": "\\b[A-Za-z_ÁÉÍÓÚáéíóúÑñ][A-Za-z0-9_ÁÉÍÓÚáéíóúÑñ]*(?=\\[)"
                }
            ]
        },

        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.gaddis",
                    "match": "(\\(|\\)|\\[|\\]|,|:)"
                }
            ]
        }
    }
}